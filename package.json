{
  "name": "Klubo",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "serve": "node scripts/serve.js",
    "start": "node scripts/serve.js",
    "lint": "next lint",
    "electron": "electron .",
    "electron:build": "next build && electron-builder"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "electron-updater": "^6.8.9",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^1.16.0",
    "megajs": "^1.3.10",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "3.8.0",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.4.2",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  },
  "build": {
    "appId": "com.klubo.app",
    "productName": "Klubo",
    "files": [
      "electron/**/*",
      "scripts/**/*",
      "out/**/*",
      "build/icon.png",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Klubo",
        "schemes": ["klubo"]
      }
    ],
    "directories": {
      "output": "dist-electron"
    },
    "publish": {
      "provider": "github",
      "owner": "FlaviusBervillus",
      "repo": "Klubo",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build/icon.icns",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  }
}
